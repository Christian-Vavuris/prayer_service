# Vercel Postgres — copy from Vercel dashboard after adding Postgres storage
POSTGRES_URL=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=

# The "from" address for confirmation emails (must be a verified domain in Resend)
RESEND_FROM_EMAIL=

# Bot protection — Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
# Create a site, copy the site key (public) and secret key (server-side)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Bot protection — allowed origin for browser-based submissions
# Set to your production URL, e.g. https://www.prayerapi.org
# Requests from other origins are rejected; requests with no Origin header (direct API calls) are allowed.
ALLOWED_ORIGIN=
